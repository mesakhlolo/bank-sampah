{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "laravel-boost": {
                "type": "local",
                "command": [
                    "php",
                    "artisan",
                    "boost:mcp"
                ],
                "enabled": true,
                "timeout": 30000
            },
            "context7": {
              "type": "remote",
              "url": "https://mcp.context7.com/mcp"
            }
        }
    }
}
